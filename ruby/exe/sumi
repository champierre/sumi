#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the sumi executable bundled with the sumi-ruby gem, passing all arguments through.

require "sumi/ruby"

begin
  executable = Sumi::Ruby.executable
rescue Sumi::Ruby::Error => e
  warn "sumi-ruby: #{e.message}"
  exit 1
end

# [executable, executable] の形で渡すと、引数がないときもシェルを経由せずに実行される。
# 文字列 1 個の exec はパスにスペースなどが含まれるとシェル経由になり、起動に失敗する。
exec([executable, executable], *ARGV)
