<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  office:version="1.2"
  office:mimetype="application/vnd.oasis.opendocument.text">
  <office:automatic-styles>
    <style:style style:name="Title1" style:family="paragraph" style:parent-style-name="Heading">
      <style:text-properties fo:color="#1a4fbf" fo:font-size="22pt" fo:font-weight="bold"/>
    </style:style>
    <style:style style:name="Title2" style:family="paragraph" style:parent-style-name="Heading">
      <style:text-properties fo:color="#b3261e" fo:font-size="16pt" fo:font-weight="bold"/>
    </style:style>

    <style:style style:name="TableFrame" style:family="table">
      <style:table-properties style:width="16cm" table:align="left"/>
    </style:style>
    <style:style style:name="ColRegion" style:family="table-column">
      <style:table-column-properties style:column-width="5cm"/>
    </style:style>
    <style:style style:name="ColQ" style:family="table-column">
      <style:table-column-properties style:column-width="2.75cm"/>
    </style:style>

    <style:style style:name="HeaderCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#1a4fbf" fo:padding="0.1cm"/>
    </style:style>
    <style:style style:name="HeaderText" style:family="paragraph">
      <style:text-properties fo:color="#ffffff" fo:font-weight="bold"/>
    </style:style>

    <style:style style:name="AltCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#dbe9ff" fo:padding="0.1cm"/>
    </style:style>
    <style:style style:name="PlainCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#ffffff" fo:padding="0.1cm"/>
    </style:style>
    <style:style style:name="WarnCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#fff3b0" fo:padding="0.1cm"/>
    </style:style>
    <style:style style:name="WarnText" style:family="paragraph">
      <style:text-properties fo:color="#7a5b00" fo:font-weight="bold"/>
    </style:style>

    <style:style style:name="ShapeTableFrame" style:family="table">
      <style:table-properties style:width="6cm" table:align="left"/>
    </style:style>
    <style:style style:name="ShapeCol" style:family="table-column">
      <style:table-column-properties style:column-width="6cm"/>
    </style:style>
    <style:style style:name="ShapeRow" style:family="table-row">
      <style:table-row-properties style:row-height="3.5cm" style:use-optimal-row-height="false"/>
    </style:style>
    <style:style style:name="ShapeCell" style:family="table-cell">
      <style:table-cell-properties fo:background-color="#2a9d8f"
        fo:border="0.15cm solid #264653"/>
    </style:style>
  </office:automatic-styles>

  <office:body>
    <office:text>
      <text:h text:style-name="Title1" text:outline-level="1">Quarterly Report</text:h>
      <text:h text:style-name="Title2" text:outline-level="2">Regional Sales Summary</text:h>

      <table:table table:name="SalesTable" table:style-name="TableFrame">
        <table:table-column table:style-name="ColRegion"/>
        <table:table-column table:style-name="ColQ"/>
        <table:table-column table:style-name="ColQ"/>
        <table:table-column table:style-name="ColQ"/>
        <table:table-column table:style-name="ColQ"/>

        <table:table-row>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="HeaderText">Region</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="HeaderText">Q1</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="HeaderText">Q2</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="HeaderText">Q3</text:p></table:table-cell>
          <table:table-cell table:style-name="HeaderCell"><text:p text:style-name="HeaderText">Q4</text:p></table:table-cell>
        </table:table-row>

        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p>North</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>120</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>135</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>142</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>150</text:p></table:table-cell>
        </table:table-row>

        <table:table-row>
          <table:table-cell table:style-name="AltCell"><text:p>South</text:p></table:table-cell>
          <table:table-cell table:style-name="AltCell"><text:p>98</text:p></table:table-cell>
          <table:table-cell table:style-name="AltCell"><text:p>110</text:p></table:table-cell>
          <table:table-cell table:style-name="AltCell"><text:p>105</text:p></table:table-cell>
          <table:table-cell table:style-name="AltCell"><text:p>120</text:p></table:table-cell>
        </table:table-row>

        <table:table-row>
          <table:table-cell table:style-name="PlainCell"><text:p>East</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>140</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>128</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>133</text:p></table:table-cell>
          <table:table-cell table:style-name="PlainCell"><text:p>145</text:p></table:table-cell>
        </table:table-row>

        <table:table-row>
          <table:table-cell table:style-name="AltCell"><text:p>West</text:p></table:table-cell>
          <table:table-cell table:style-name="AltCell"><text:p>85</text:p></table:table-cell>
          <table:table-cell table:style-name="AltCell"><text:p>90</text:p></table:table-cell>
          <table:table-cell table:style-name="AltCell"><text:p>95</text:p></table:table-cell>
          <table:table-cell table:style-name="AltCell"><text:p>100</text:p></table:table-cell>
        </table:table-row>

        <table:table-row>
          <table:table-cell table:style-name="WarnCell"><text:p text:style-name="WarnText">Overdue accounts</text:p></table:table-cell>
          <table:table-cell table:style-name="WarnCell"><text:p text:style-name="WarnText">12</text:p></table:table-cell>
          <table:table-cell table:style-name="WarnCell"><text:p text:style-name="WarnText">15</text:p></table:table-cell>
          <table:table-cell table:style-name="WarnCell"><text:p text:style-name="WarnText">9</text:p></table:table-cell>
          <table:table-cell table:style-name="WarnCell"><text:p text:style-name="WarnText">20</text:p></table:table-cell>
        </table:table-row>
      </table:table>

      <text:p/>
      <table:table table:name="ShapeTable" table:style-name="ShapeTableFrame">
        <table:table-column table:style-name="ShapeCol"/>
        <table:table-row table:style-name="ShapeRow">
          <table:table-cell table:style-name="ShapeCell"><text:p/></table:table-cell>
        </table:table-row>
      </table:table>
    </office:text>
  </office:body>
</office:document>
