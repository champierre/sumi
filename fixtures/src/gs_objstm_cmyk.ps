%!PS
% gs_objstm_cmyk.ps
% Fixture: CMYK fills/strokes, RGB text, a Separation spot color, an axial
% shading (shfill) with a DeviceRGB Type 2 function, and a small RGB image
% via colorimage. Intended to be run through Ghostscript pdfwrite with
% object-stream / xref-stream options so the resulting PDF uses /ObjStm
% and /Type /XRef.

/Helvetica-Bold findfont 20 scalefont setfont

% ---------- Page 1 ----------
% CMYK filled rectangle
0.0 0.8 0.9 0.0 setcmykcolor
80 700 150 80 rectfill

% CMYK stroked rectangle
0.9 0.1 0.0 0.0 setcmykcolor
6 setlinewidth
260 700 150 80 rectstroke

% RGB text
0.8 0.0 0.0 setrgbcolor
80 640 moveto
(GS CMYK + Separation + Shading Test) show

% Separation spot color "SpotRed": tint -> DeviceCMYK
[ /Separation (SpotRed) /DeviceCMYK
  { dup 0 mul exch dup 0.9 mul exch dup 0.8 mul exch 0 mul }
] setcolorspace
0.9 setcolor
80 560 200 70 rectfill

% Reset to default gray before shading setup
0 setgray

% ---------- Axial shading (shfill) with DeviceRGB Type 2 function ----------
<<
  /ShadingType 2
  /ColorSpace /DeviceRGB
  /Coords [80 460 380 460]
  /Function <<
    /FunctionType 2
    /Domain [0 1]
    /C0 [1 0 0]
    /C1 [0 0 1]
    /N 1
  >>
  /Extend [true true]
>>
gsave
80 420 300 80 rectclip
shfill
grestore

% ---------- Small RGB image via colorimage ----------
gsave
420 420 translate
64 64 scale
/picstr 64 3 mul string def
64 64 8
[64 0 0 -64 0 64]
{
  currentfile picstr readhexstring pop
}
false 3
colorimage
































































grestore

showpage

% ---------- Page 2 ----------
/Helvetica-Bold findfont 20 scalefont setfont
0.8 0.0 0.0 setrgbcolor
80 780 moveto
(Page 2: more CMYK shapes) show

0 setgray
1.0 0.0 0.0 0.0 setcmykcolor
80 650 100 100 rectfill
0.0 1.0 0.0 0.0 setcmykcolor
200 650 100 100 rectfill
0.0 0.0 1.0 0.0 setcmykcolor
320 650 100 100 rectfill
0.0 0.0 0.0 1.0 setcmykcolor
440 650 100 100 rectfill

showpage
